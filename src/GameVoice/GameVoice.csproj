<Project Sdk="Microsoft.NET.Sdk.Razor">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>GameVoice</RootNamespace>
    <PackageId>GameVoice</PackageId>
    <Version>1.1.0</Version>
    <Authors>djaus2</Authors>
    <Description>Reusable Blazor Server voice and text chat: push-to-talk speech recognition, text-to-speech playback, voice floor, mute, per-user voice preferences, in-game chat log and lobby chat.</Description>
    <RepositoryUrl>https://github.com/djaus2/GameVoice</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

</Project>
